---
// Sukrara — https://github.com/mauriciabad/sukrara
// Copyright (C) 2026 Maurici Abad
// SPDX-License-Identifier: GPL-3.0-or-later
// A row of names as pills: the sensors Sukrara reads (with the app's sensor icon), the small things it also does.
interface Props {
	items: string[];
	label: string;
	/** Each pill wears the app's sensor icon (core/designsystem ds_ic_dia_sensor: the disc and its signal). */
	sensor?: boolean;
}
const { items, label, sensor = false } = Astro.props;
---

<ul class="sk-chips not-content" aria-label={label}>
	{
		items.map((item) => (
			<li>
				{sensor && (
					<svg viewBox="0 0 960 960" width="1.1em" height="1.1em" aria-hidden="true">
						<circle cx="373" cy="587" r="230" fill="none" stroke="currentColor" stroke-width="80" />
						<circle cx="373" cy="587" r="80" fill="currentColor" />
						<path
							d="M466.2 239.3A360 360 0 0 1 720.7 493.8M512.6 138.2A470 470 0 0 1 821.8 447.4"
							fill="none"
							stroke="currentColor"
							stroke-width="70"
							stroke-linecap="round"
						/>
					</svg>
				)}
				{item}
			</li>
		))
	}
</ul>

<style>
	.sk-chips {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.sk-chips li {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--sk-surface-line);
		background: var(--sk-surface);
		color: var(--sl-color-gray-1);
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	.sk-chips svg {
		color: var(--sl-color-accent-high);
		flex: none;
	}
</style>
