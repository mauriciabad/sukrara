---
// Sukrara — https://github.com/mauriciabad/sukrara
// Copyright (C) 2026 Maurici Abad
// SPDX-License-Identifier: GPL-3.0-or-later
// A home page section: a short title (with "See all" when the features page has its group), an optional lead, then
// its content.
interface Props {
	title: string;
	id?: string;
	lead?: string;
	/** Its group on the features page: /features/#alerts. */
	more?: string;
}
const { title, id, lead, more } = Astro.props;
const t = Astro.locals.t;
---

<section class="sk-section" id={id}>
	<div class="sk-section__head">
		<h2>{title}</h2>
		{
			more && (
				<a href={more} aria-label={`${t('site.features.seeAll')}: ${title}`}>
					{t('site.features.seeAll')} <span aria-hidden="true">→</span>
				</a>
			)
		}
	</div>
	{lead && <p class="sk-section__lead">{lead}</p>}
	<slot />
</section>

<style>
	.sk-section {
		padding-block: 3.5rem 0.5rem;
	}
	.sk-section__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}
	.sk-section__head a {
		font-weight: 600;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
	}
	.sk-section__head a:hover {
		text-decoration: underline;
	}
	.sk-section h2 {
		margin: 0;
		font-family: var(--sk-font-display);
		font-weight: 800;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.sk-section__lead {
		margin: 0.75rem 0 0;
		max-width: 42rem;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
	.sk-section > :global(* + *) {
		margin-top: 1.75rem;
	}
	.sk-section > :global(.sk-section__lead) {
		margin-top: 0.75rem;
	}
</style>
