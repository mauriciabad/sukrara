---
// Sukrara — https://github.com/mauriciabad/sukrara
// Copyright (C) 2026 Maurici Abad
// SPDX-License-Identifier: GPL-3.0-or-later
/**
 * The watch face playground: the face drawn by its own reference implementation, play and the timeline right under
 * it, the scenario and its speed, then presets and every input. The page holds the frame; playground.ts fills and runs
 * it. The first face is drawn at build time, so it shows before the script runs. The face sits in the tour's round
 * screen; the play bar and the setting controls are the tour's too (PlayBar, choices.ts, face-ui.css).
 *   <FacePlayground />            <FacePlayground id="pg2" />
 */
import { aura } from './aura/index.ts';
import FaceScreen from './FaceScreen.astro';
import PlayBar from './PlayBar.astro';
import { words } from './strings.ts';
import './face-ui.css';

type Props = { id?: string };
const { id = 'pg' } = Astro.props;
const lang = Astro.locals.starlightRoute.lang === 'es' ? 'es' : 'en';
const w = words(lang);
const first = aura.render(aura.defaults(), lang, { id });
---

<div class="fp not-content" data-uid={id} data-lang={lang}>
	<div class="fp-stage">
		<figure class="fp-screen" aria-label={w.face}>
			<FaceScreen size="22rem">
				<div data-face set:html={first} />
			</FaceScreen>
		</figure>
		<PlayBar label={w.play} scrubLabel={w.timeline} max={1} value={0} step="any" />
		<div class="fp-time" role="group" aria-label={w.scenario}>
			<label class="fu-list">
				<span>{w.scenario}</span>
				<select data-scenario></select>
			</label>
			<p class="fp-about" data-about></p>
			<div class="fu-set" role="group" aria-label={w.speed}>
				<span class="fp-label" aria-hidden="true">{w.speed}</span>
				<div class="fp-speeds" data-speeds></div>
			</div>
		</div>
	</div>
	<div class="fp-panel">
		<div class="fp-presets">
			<label class="fu-list">
				<span>{w.presets}</span>
				<select data-preset></select>
			</label>
			<button type="button" class="fp-reset" data-reset>{w.reset}</button>
		</div>
		<div class="fp-controls" data-controls aria-label={w.inputs} role="group"></div>
	</div>
</div>

<script>
	import { aura } from './aura/index.ts';
	import { mountPlayground } from './playground.ts';

	for (const root of document.querySelectorAll<HTMLElement>('.fp')) {
		mountPlayground(root, aura, root.dataset.lang === 'es' ? 'es' : 'en');
	}
</script>

<style>
	:global(:root:has(.fp)) {
		--sl-content-width: 62rem;
	}
	.fp {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		margin-block: 1.5rem;
	}
	@media (min-width: 50rem) {
		.fp {
			grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
			align-items: start;
		}
		.fp-stage {
			position: sticky;
			top: calc(var(--sl-nav-height, 4rem) + 1rem);
		}
	}
	.fp-stage,
	.fp-panel {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.fp-screen {
		margin: 0;
	}
	.fp-time,
	.fp-panel {
		padding: 1rem;
		border-radius: var(--sk-radius, 1rem);
		background: var(--sk-surface);
		border: 1px solid var(--sk-surface-line);
	}
	.fp-time {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.fp-about {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.fp-label {
		display: block;
		margin-bottom: 0.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	/* the speeds: one segmented row */
	.fp-speeds {
		display: flex;
		padding: 2px;
		border-radius: 999px;
		border: 1px solid var(--sk-surface-line);
		background: var(--sl-color-bg);
	}
	.fp-speeds :global(button) {
		flex: 1;
		font: 700 var(--sl-text-xs) / 1 var(--sk-font-display);
		color: var(--sl-color-gray-2);
		background: none;
		border: 0;
		border-radius: 999px;
		padding: 0.5rem 0.4rem;
		min-height: 2.25rem;
		cursor: pointer;
		font-variant-numeric: tabular-nums;
	}
	.fp-speeds :global(button[aria-pressed='true']) {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.fp-speeds :global(button:focus-visible),
	.fp-reset:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.fp-presets {
		display: flex;
		gap: 0.75rem;
		align-items: end;
	}
	.fp-presets .fu-list {
		flex: 1;
	}
	.fp-reset {
		font: 700 var(--sl-text-sm) / 1 var(--sk-font-display);
		color: var(--sl-color-white);
		background: var(--sl-color-bg);
		border: 1px solid var(--sk-surface-line);
		border-radius: 999px;
		padding: 0.6rem 1rem;
		min-height: 2.5rem;
		cursor: pointer;
	}
	.fp-reset:hover {
		border-color: var(--sl-color-accent);
	}
	/* the inputs: a group each, under its name; cards and switches take the whole row, the rest two to a row */
	.fp-controls {
		display: grid;
		gap: 1.25rem;
	}
	.fp-controls :global(.fp-group) {
		margin: 0;
		padding: 1rem 0 0;
		border: 0;
		border-top: 1px solid var(--sk-surface-line);
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
		gap: 0.9rem 1rem;
	}
	.fp-controls :global(.fp-group > legend) {
		font: 800 var(--sl-text-base) / 1.2 var(--sk-font-display);
		color: var(--sl-color-white);
		padding-inline-end: 0.5rem;
	}
	.fp-controls :global(.fp-wide),
	.fp-controls :global(.fp-number) {
		grid-column: 1 / -1;
	}
	.fp-controls :global(.fp-field) {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.fp-controls :global(.fp-pair) {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
	.fp-controls :global(.fp-pair input[type='range']) {
		flex: 1;
		min-width: 0;
		accent-color: var(--sl-color-accent);
	}
	.fp :global(input[type='number']),
	.fp :global(input[type='time']) {
		font: 600 var(--sl-text-sm) / 1.2 var(--__sl-font);
		color: var(--sl-color-white);
		background: var(--sl-color-bg);
		border: 1px solid var(--sk-surface-line);
		border-radius: 0.6rem;
		padding: 0.4rem 0.5rem;
		min-height: 2.5rem;
	}
	.fp-controls :global(.fp-pair input[type='number']) {
		width: 5.5rem;
	}
	.fp :global(:disabled) {
		opacity: 0.55;
		cursor: not-allowed;
	}
</style>
