/**
 * One main feature on the features page: a row with the app's icon for it, its name and one line; a click opens a few
 * bullets and where to learn more, written in the page. `/features/#alerts` opens it.
 *   <Feature id="alerts" icon="notifications_active" title="Discreet alerts" summary="Each alert its own sound.">
 *
 *   - Quiet once you've acted.
 *
 *   [Listen to the sounds](/sounds/)
 *
 *   </Feature>
 */
import type { LogoName } from '../../lib/logos';
import DsIcon from '../DsIcon.astro';
import Logo from '../Logo.astro';

type Props = { id: string; title: string; summary: string } & ({ icon: string } | { logo: LogoName });
const props = Astro.props;
---

<details class="sk-feature" id={props.id}>
	<summary>
		<span class="sk-feature__icon">
			{'logo' in props ? <Logo name={props.logo} size="1.35rem" /> : <DsIcon name={props.icon} size="1.5rem" />}
		</span>
		<span class="sk-feature__text">
			<h2>{props.title}</h2>
			<span>{props.summary}</span>
		</span>
		<DsIcon name="chevron_right" size="1.5rem" class="sk-feature__chevron" />
	</summary>
	<div class="sk-feature__more">
		<slot />
	</div>
</details>

<script>
	// A link to /features/#alerts opens that feature.
	const openTarget = () => {
		const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
		if (target instanceof HTMLDetailsElement && target.classList.contains('sk-feature')) target.open = true;
	};
	openTarget();
	addEventListener('hashchange', openTarget);
</script>

<style>
	.sk-feature {
		margin: 0;
		scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
	}
	.sk-feature + .sk-feature {
		border-top: 1px solid var(--sk-surface-line);
	}
	summary {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.25rem;
		list-style: none;
		cursor: pointer;
		border-radius: var(--sk-radius);
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:hover h2 {
		color: var(--sl-color-accent-high);
	}
	summary:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
	.sk-feature__icon {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.75rem;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
	}
	.sk-feature__text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	h2 {
		margin: 0;
		font-family: var(--sk-font-display);
		font-size: var(--sl-text-lg);
		font-weight: 750;
		line-height: 1.25;
		color: var(--sl-color-white);
	}
	.sk-feature__text > span {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.4;
	}
	summary :global(.sk-feature__chevron) {
		color: var(--sl-color-gray-3);
		transition: transform 0.2s ease;
	}
	.sk-feature[open] summary :global(.sk-feature__chevron) {
		transform: rotate(90deg);
	}
	/* What opens: under the name, past the icon. */
	.sk-feature__more {
		padding: 0 1.25rem 1.25rem calc(1.25rem + 2.5rem + 1rem);
		color: var(--sl-color-gray-2);
		line-height: 1.5;
	}
	.sk-feature__more > :global(ul:not([class])) {
		margin: 0;
		padding-inline-start: 1.1rem;
	}
	.sk-feature__more > :global(ul:not([class]) > li + li) {
		margin-top: 0.3rem;
	}
	.sk-feature__more > :global(ul:not([class]) > li::marker) {
		color: var(--sl-color-gray-4);
	}
	.sk-feature__more > :global(* + *) {
		margin-top: 0.85rem;
	}
	.sk-feature__more :global(a) {
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}
	@media (max-width: 40rem) {
		summary {
			gap: 0.75rem;
			padding: 0.9rem 1rem;
		}
		.sk-feature__more {
			padding: 0 1rem 1.1rem;
		}
	}
</style>
