---
// Sukrara — https://github.com/mauriciabad/sukrara
// Copyright (C) 2026 Maurici Abad
// SPDX-License-Identifier: GPL-3.0-or-later
/**
 * A group of the features page: its heading (an anchor the home page links to: /features/#alerts) and its tiles in a
 * grid, every one visible.
 *   <FeatureGroup id="alerts" title="Alerts">
 *     <FeatureTile … />
 *   </FeatureGroup>
 */
interface Props {
	id: string;
	title: string;
}
const { id, title } = Astro.props;
---

<section class="sk-fgroup not-content" aria-labelledby={`${id}-title`}>
	<h2 id={id}><span id={`${id}-title`}>{title}</span></h2>
	<ul>
		<slot />
	</ul>
</section>

<script>
	// A tile with a picture opens it in its dialog; a click on the dim backdrop closes it, like Escape.
	for (const tile of document.querySelectorAll<HTMLButtonElement>('button.sk-ftile[data-dialog]')) {
		const dialog = document.getElementById(tile.dataset.dialog!) as HTMLDialogElement | null;
		if (!dialog) continue;
		tile.addEventListener('click', () => dialog.showModal());
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
	}
</script>

<style>
	.sk-fgroup {
		margin-top: 2.75rem;
	}
	h2 {
		margin: 0 0 1rem;
		scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
		font-family: var(--sk-font-display);
		font-size: var(--sl-text-2xl);
		font-weight: 800;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
	}
	@media (max-width: 40rem) {
		ul {
			gap: 0.5rem;
		}
	}
</style>
