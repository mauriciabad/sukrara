/**
 * Where Garmin's Connect IQ store badge goes: "coming soon" until Sukrara Aura's listing is public (its app id in
 * site.ts). Then the badge and its link come back (the revert of this change).
 *   <ConnectIqBadge />
 */

const t = Astro.locals.t;
---

<span class="sk-ciq-soon not-content">{t('site.garmin.soon')}</span>

<style>
	.sk-ciq-soon {
		display: inline-block;
		padding: 0.5rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-weight: 600;
	}
	.sk-ciq {
		display: inline-block;
		margin: -2px;
		transition: transform 0.15s ease;
	}
	.sk-ciq:hover {
		transform: translateY(-2px);
	}
	.sk-ciq:active {
		transform: translateY(0) scale(0.97);
	}
	.sk-ciq img {
		display: block;
		height: 44px;
		width: auto;
		box-shadow: none;
		border-radius: 0;
	}
</style>
