---
// Sukrara — https://github.com/mauriciabad/sukrara
// Copyright (C) 2026 Maurici Abad
// SPDX-License-Identifier: GPL-3.0-or-later
// One of the Android app's own icons (lib/ds-icons.ts), in the text's colour: <DsIcon name="notifications_active" />
import { dsIcon } from '../lib/ds-icons';

interface Props {
	/** The drawable's name without `ds_ic_`. */
	name: string;
	size?: string;
	class?: string;
}
const { name, size = '1em', class: className } = Astro.props;
const { viewBox, body } = dsIcon(name);
---

<svg viewBox={viewBox} width={size} height={size} class:list={['sk-ds-icon', className]} aria-hidden="true" set:html={body} />

<style>
	.sk-ds-icon {
		flex: none;
	}
</style>
