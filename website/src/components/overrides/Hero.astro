---
// Sukrara — https://github.com/mauriciabad/sukrara
// Copyright (C) 2026 Maurici Abad
// SPDX-License-Identifier: GPL-3.0-or-later
/**
 * The home page's hero, in the brand: the icon's cyan-to-navy gradient across the whole width, the title and tagline
 * from the page's `hero` frontmatter (so each language writes its own), its actions, the newest version, and the
 * phone's glucose card with the Mac's menu bar panel beside it, the live dot beating.
 */
import { latestRelease } from '../../lib/release';
import Screenshot from '../Screenshot.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { lang } = Astro.locals.starlightRoute;
const t = Astro.locals.t;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const release = await latestRelease();
const date = release.date && new Intl.DateTimeFormat(lang, { dateStyle: 'medium' }).format(release.date);
---

<section class="sk-hero not-content">
	<div class="sk-hero__copy">
		<p class="sk-hero__eyebrow"><span class="sk-live" aria-hidden="true"></span>{t('site.hero.free')}</p>
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="sk-hero__tagline" set:html={tagline} />}
		<div class="sk-hero__actions">
			{
				actions.map(({ link, text, variant }) => (
					<a href={link} class:list={['sk-hero__action', variant === 'primary' ? 'is-primary' : 'is-secondary']}>
						{text}
					</a>
				))
			}
		</div>
		<p class="sk-hero__version">
			{release.version && date && <>{t('site.hero.version', { version: release.version, date })} · </>}
			{t('site.preview')}
		</p>
	</div>
	<div class="sk-hero__art">
		<div class="sk-hero__phone"><Screenshot name="card" width={460} theme="dark" eager /></div>
		<div class="sk-hero__mac"><Screenshot name="macPanel" width={250} theme="dark" eager /></div>
	</div>
</section>

<style>
	.sk-hero {
		position: relative;
		isolation: isolate;
		display: grid;
		gap: 2.5rem;
		align-items: center;
		padding-block: 3rem 4rem;
		color: #fff;
	}
	/* The gradient runs edge to edge, behind the content column, from under the header. */
	.sk-hero::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: -1.5rem calc(50% - 50vw) 0;
		background:
			radial-gradient(circle at 15% 0%, rgb(255 255 255 / 0.18), transparent 55%),
			radial-gradient(circle at 85% 90%, rgb(198 244 50 / 0.12), transparent 40%),
			var(--sk-gradient);
	}
	:root[data-theme='dark'] .sk-hero::before {
		background:
			radial-gradient(circle at 15% 0%, rgb(255 255 255 / 0.12), transparent 55%),
			radial-gradient(circle at 85% 90%, rgb(198 244 50 / 0.1), transparent 40%),
			linear-gradient(160deg, #137d93 0%, #061a36 72%);
	}
	@media (min-width: 50rem) {
		.sk-hero {
			grid-template-columns: 1.05fr 1fr;
			padding-block: 4.5rem 5.5rem;
		}
	}
	.sk-hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 1.25rem;
		padding: 0.35rem 0.9rem 0.35rem 0.7rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.14);
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	.sk-live {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: var(--sk-lime);
		box-shadow: 0 0 0 0 rgb(198 244 50 / 0.7);
		animation: sk-beat 2.4s ease-out infinite;
	}
	@keyframes sk-beat {
		0% {
			box-shadow: 0 0 0 0 rgb(198 244 50 / 0.7);
		}
		70%,
		100% {
			box-shadow: 0 0 0 0.75rem rgb(198 244 50 / 0);
		}
	}
	.sk-hero h1 {
		margin: 0;
		color: #fff;
		font-size: clamp(2.75rem, 7vw, 4.75rem);
		line-height: 1.02;
		letter-spacing: -0.03em;
	}
	.sk-hero h1 :global(em) {
		font-style: normal;
		color: var(--sk-lime);
	}
	.sk-hero__tagline {
		margin: 1.25rem 0 0;
		max-width: 34rem;
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		line-height: 1.5;
		color: rgb(255 255 255 / 0.9);
	}
	.sk-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.sk-hero__action {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.5rem;
		border-radius: 999px;
		font-family: var(--sk-font-display);
		font-weight: 800;
		font-size: var(--sl-text-lg);
		text-decoration: none;
		transition:
			transform 0.15s ease,
			background-color 0.15s ease;
	}
	.sk-hero__action:hover {
		transform: translateY(-2px);
	}
	.sk-hero__action:active {
		transform: translateY(0) scale(0.97);
	}
	.sk-hero__action.is-primary {
		background: var(--sk-lime);
		color: var(--sk-navy);
		box-shadow: 0 0.75rem 2rem rgb(198 244 50 / 0.25);
	}
	.sk-hero__action.is-secondary {
		color: #fff;
		box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.75);
	}
	.sk-hero__action.is-secondary:hover {
		background: rgb(255 255 255 / 0.12);
	}
	.sk-hero__version {
		margin: 1.25rem 0 0;
		font-size: var(--sl-text-sm);
		color: rgb(255 255 255 / 0.8);
	}
	.sk-hero__art {
		position: relative;
		padding-bottom: 26%;
		margin-inline-end: 4%;
	}
	.sk-hero__phone,
	.sk-hero__mac {
		border-radius: 1.4rem;
		background: #1c1c1e;
		box-shadow:
			0 2rem 4rem rgb(4 18 40 / 0.55),
			0 0 0 1px rgb(255 255 255 / 0.08);
		overflow: hidden;
	}
	.sk-hero__phone {
		padding: 1.25rem;
		animation: sk-float 7s ease-in-out infinite;
	}
	.sk-hero__mac {
		position: absolute;
		width: 40%;
		right: -6%;
		bottom: -2%;
		border-radius: 0.9rem;
		animation: sk-float 7s ease-in-out -3.5s infinite;
	}
	.sk-hero__art :global(img) {
		display: block;
		width: 100%;
		height: auto;
		box-shadow: none;
		border-radius: 0;
	}
	@keyframes sk-float {
		50% {
			transform: translateY(-0.5rem);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.sk-live,
		.sk-hero__phone,
		.sk-hero__mac {
			animation: none;
		}
	}
</style>
