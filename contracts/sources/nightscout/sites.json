   "root": "https://ns.example.org",
   "token": null,
   "problem": null
  },
  {
   "input": "https://ns.example.org:8443",
   "root": "https://ns.example.org:8443",
   "token": null,
   "problem": null
  },
  {
   "input": "https://ns.example.org/?token=reader-0123456789abcdef",
   "root": "https://ns.example.org",
   "token": "reader-0123456789abcdef",
   "problem": null
  },
  {
   "input": "https://ns.example.org/api/v1/",
   "root": "https://ns.example.org",
   "token": null,
   "problem": null
  },
  {
   "input": "https://host.example.org/ana/",
   "root": "https://host.example.org/ana",
   "token": null,
   "problem": null
  },
  {
   "input": "http://ns.example.org",
   "root": "http://ns.example.org",
   "token": null,
   "problem": "https"
  },
  {
