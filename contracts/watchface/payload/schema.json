{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sukrara.mauri.app/contracts/watchface/payload/schema.json",
  "title": "Sukrara's watch payload, version 4",
  "description": "What the phone sends Sukrara's Connect IQ apps, one branch per profile (README.md). Times are absolute epoch seconds.",
  "$defs": {
    "time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "until": {
      "type": "integer",
      "minimum": -1,
      "maximum": 2147483647,
      "description": "-1 = no end"
    },
    "mgdl": {
      "type": "integer",
      "minimum": 39,
      "maximum": 401,
      "description": "39 = LO, 401 = HI"
    },
    "side": {
      "enum": [
        "low",
        "high"
      ]
    },
    "last": {
      "description": "the card's last treatment from sent on: this answer until 'until' (-1 = no end), then 'next' (null = none)",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "items",
            "until",
            "next"
          ],
          "properties": {
            "t": {
              "$ref": "#/$defs/time"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "k",
                  "a",
                  "t",
                  "m"
                ],
                "properties": {
                  "k": {
                    "enum": [
                      "rapid",
                      "carbs"
                    ]
                  },
                  "a": {
                    "type": "number",
                    "minimum": 0
                  },
                  "t": {
                    "$ref": "#/$defs/time"
                  },
                  "m": {
                    "$ref": "#/$defs/until",
                    "description": "its mute's end, -1 = its kind mutes nothing"
                  }
                }
              }
            },
            "until": {
              "$ref": "#/$defs/until"
            },
            "next": {
              "$ref": "#/$defs/last"
            }
          }
        }
      ]
    },
    "permille": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "minItems": 6,
          "maxItems": 6
        }
      ]
    },
    "ring": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "k",
          "side",
          "relaxed",
          "less"
        ],
        "properties": {
          "k": {
            "enum": [
              "very_low",
              "low",
              "high",
              "very_high",
              "extremely_high",
              "falling_fast",
              "rising_fast",
              "no_data"
            ]
          },
          "side": {
            "enum": [
              "low",
              "high",
              "none"
            ]
          },
          "relaxed": {
            "type": "boolean"
          },
          "less": {
            "type": "boolean"
          }
        }
      }
    },
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k",
            "w",
            "v",
            "dim",
            "r",
            "b",
            "mark"
          ],
          "properties": {
            "k": {
              "const": "tir"
            },
            "w": {
              "type": "integer",
              "minimum": 1
            },
            "v": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              ]
            },
            "dim": {
              "type": "boolean"
            },
            "r": {
              "enum": [
                "in",
                "tight"
              ]
            },
            "b": {
              "$ref": "#/$defs/permille"
            },
            "mark": {
              "enum": [
                "none",
                "laurel",
                "flowers",
                "crown"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k",
            "w",
            "v",
            "dim"
          ],
          "properties": {
            "k": {
              "enum": [
                "gmi",
                "avg",
                "cv"
              ]
            },
            "w": {
              "type": "integer",
              "minimum": 1
            },
            "v": {
              "type": [
                "number",
                "null"
              ]
            },
            "dim": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "usual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last",
        "usual"
      ],
      "properties": {
        "last": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "usual": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "p",
        "sent",
        "unit",
        "bands",
        "g",
        "hist",
        "st",
        "last",
        "sensor",
        "tir"
      ],
      "properties": {
        "v": {
          "const": 4
        },
        "p": {
          "const": "aura"
        },
        "sent": {
          "$ref": "#/$defs/time"
        },
        "unit": {
          "enum": [
            "mgdl",
            "mmol"
          ]
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "g": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t",
                "v",
                "rate",
                "band",
                "deg"
              ],
              "properties": {
                "t": {
                  "$ref": "#/$defs/time"
                },
                "v": {
                  "$ref": "#/$defs/mgdl"
                },
                "rate": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "band": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": -3,
                      "maximum": 3
                    }
                  ]
                },
                "deg": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ]
                }
              }
            }
          ]
        },
        "st": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "k",
                "side"
              ],
              "properties": {
                "k": {
                  "const": "needed"
                },
                "side": {
                  "$ref": "#/$defs/side"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "k",
                "side",
                "until"
              ],
              "properties": {
                "k": {
                  "enum": [
                    "taken",
                    "paused"
                  ]
                },
                "side": {
                  "$ref": "#/$defs/side"
                },
                "until": {
                  "$ref": "#/$defs/until"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "k",
                "until"
              ],
              "properties": {
                "k": {
                  "const": "muted"
                },
                "until": {
                  "$ref": "#/$defs/until"
                }
              }
            }
          ]
        },
        "hist": {
          "type": "array",
          "description": "empty without g, else 36 slots (3 h) oldest first",
          "oneOf": [
            {
              "maxItems": 0
            },
            {
              "minItems": 36,
              "maxItems": 36
            }
          ],
          "items": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/mgdl"
              }
            ]
          }
        },
        "last": {
          "$ref": "#/$defs/last"
        },
        "sensor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "s"
              ],
              "properties": {
                "s": {
                  "enum": [
                    "none",
                    "ended"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "s",
                "start",
                "ready",
                "hold"
              ],
              "properties": {
                "s": {
                  "const": "warmup"
                },
                "start": {
                  "$ref": "#/$defs/time"
                },
                "ready": {
                  "$ref": "#/$defs/time"
                },
                "hold": {
                  "$ref": "#/$defs/time"
                },
                "end": {
                  "$ref": "#/$defs/time"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "s"
              ],
              "properties": {
                "s": {
                  "const": "active"
                },
                "start": {
                  "$ref": "#/$defs/time"
                },
                "end": {
                  "$ref": "#/$defs/time"
                },
                "warn": {
                  "$ref": "#/$defs/time"
                }
              }
            }
          ]
        },
        "tir": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pct",
                "until"
              ],
              "properties": {
                "pct": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "until": {
                  "$ref": "#/$defs/time"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "p",
        "sent",
        "unit",
        "bands",
        "g",
        "hist",
        "st",
        "ring",
        "last",
        "sensor",
        "tx",
        "ranges",
        "m",
        "else",
        "ro",
        "log",
        "ds",
        "rep",
        "repD"
      ],
      "properties": {
        "v": {
          "const": 4
        },
        "p": {
          "const": "app"
        },
        "sent": {
          "$ref": "#/$defs/time"
        },
        "unit": {
          "enum": [
            "mgdl",
            "mmol"
          ]
        },
        "bands": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "g": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t",
                "v",
                "rate",
                "band",
                "deg"
              ],
              "properties": {
                "t": {
                  "$ref": "#/$defs/time"
                },
                "v": {
                  "$ref": "#/$defs/mgdl"
                },
                "rate": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "band": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": -3,
                      "maximum": 3
                    }
                  ]
                },
                "deg": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ]
                }
              }
            }
          ]
        },
        "st": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "k",
                "side"
              ],
              "properties": {
                "k": {
                  "const": "needed"
                },
                "side": {
                  "$ref": "#/$defs/side"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "k",
                "side",
                "until"
              ],
              "properties": {
                "k": {
                  "enum": [
                    "taken",
                    "paused"
                  ]
                },
                "side": {
                  "$ref": "#/$defs/side"
                },
                "until": {
                  "$ref": "#/$defs/until"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "k",
                "until"
              ],
              "properties": {
                "k": {
                  "const": "muted"
                },
                "until": {
                  "$ref": "#/$defs/until"
                }
              }
            }
          ]
        },
        "hist": {
          "type": "array",
          "description": "empty without g, else 288 slots (24 h) oldest first",
          "oneOf": [
            {
              "maxItems": 0
            },
            {
              "minItems": 288,
              "maxItems": 288
            }
          ],
          "items": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/mgdl"
              }
            ]
          }
        },
        "ring": {
          "$ref": "#/$defs/ring"
        },
        "last": {
          "$ref": "#/$defs/last"
        },
        "sensor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "s"
              ],
              "properties": {
                "s": {
                  "enum": [
                    "none",
                    "ended"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "s",
                "start",
                "ready",
                "hold"
              ],
              "properties": {
                "s": {
                  "const": "warmup"
                },
                "start": {
                  "$ref": "#/$defs/time"
                },
                "ready": {
                  "$ref": "#/$defs/time"
                },
                "hold": {
                  "$ref": "#/$defs/time"
                },
                "end": {
                  "$ref": "#/$defs/time"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "s"
              ],
              "properties": {
                "s": {
                  "const": "active"
                },
                "start": {
                  "$ref": "#/$defs/time"
                },
                "end": {
                  "$ref": "#/$defs/time"
                },
                "warn": {
                  "$ref": "#/$defs/time"
                }
              }
            }
          ]
        },
        "tx": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "k",
            "a",
            "i"
          ],
          "description": "the day's treatments as four lists side by side, oldest first",
          "properties": {
            "t": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/time"
              }
            },
            "k": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "enum": [
                  "rapid",
                  "long",
                  "carbs"
                ]
              }
            },
            "a": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "i": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f-]{8}$"
              }
            }
          }
        },
        "ranges": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "w",
                  "pct",
                  "b"
                ],
                "properties": {
                  "w": {
                    "enum": [
                      86400,
                      604800
                    ]
                  },
                  "pct": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "b": {
                    "$ref": "#/$defs/permille"
                  }
                }
              }
            ]
          }
        },
        "m": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "else": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/metric"
            }
          ]
        },
        "ro": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "log": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "order",
                "rapid",
                "long",
                "carbs"
              ],
              "properties": {
                "order": {
                  "description": "THE kinds' order (contracts/treatments/kind-order.json): the log list's, the first focused",
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "rapid",
                      "long",
                      "carbs"
                    ]
                  }
                },
                "rapid": {
                  "$ref": "#/$defs/usual"
                },
                "long": {
                  "$ref": "#/$defs/usual"
                },
                "carbs": {
                  "$ref": "#/$defs/usual"
                }
              }
            }
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "push only, never the fetch"
        },
        "w": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$",
          "description": "push only: this watch's id on the phone, sent back as the fetch's w= query"
        },
        "ds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hours",
            "marks",
            "side",
            "crown"
          ],
          "properties": {
            "hours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 48
            },
            "marks": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rapid",
                "long",
                "carbs",
                "note"
              ],
              "properties": {
                "rapid": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "point",
                      "line",
                      "amount",
                      "time"
                    ]
                  }
                },
                "long": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "point",
                      "line",
                      "amount",
                      "time"
                    ]
                  }
                },
                "carbs": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "point",
                      "line",
                      "amount",
                      "time"
                    ]
                  }
                },
                "note": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "point",
                      "line",
                      "amount",
                      "time"
                    ]
                  }
                }
              }
            },
            "side": {
              "type": "boolean"
            },
            "crown": {
              "type": "boolean"
            }
          }
        },
        "rep": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "d",
                  "cov",
                  "b",
                  "avg",
                  "gmi",
                  "cv",
                  "ok"
                ],
                "properties": {
                  "d": {
                    "enum": [
                      1,
                      7,
                      14,
                      30
                    ]
                  },
                  "cov": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "b": {
                    "$ref": "#/$defs/permille"
                  },
                  "avg": {
                    "type": "integer"
                  },
                  "gmi": {
                    "type": "number"
                  },
                  "cv": {
                    "type": "number"
                  },
                  "ok": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255,
                    "description": "the report card's goals met, bit i = Goal i: veryHigh, above, inRange, below, veryLow, avg, gmi, cv"
                  }
                }
              }
            ]
          }
        },
        "repD": {
          "enum": [
            1,
            7,
            14,
            30
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "p",
        "sent",
        "unit",
        "bands",
        "g",
        "hist",
        "st",
        "ring"
      ],
      "properties": {
