    <!-- The alert checklist (AlertRequirement): one name per item for setup, home and Settings › Alert reliability -->
    <string name="ds_req_delivery">Alert delivery</string>
    <string name="ds_req_delivery_why">Android refused the last try to show an alert, set the next alert check or save the alerts. Sukrara tries again with every reading; the report says which step failed.</string>
    <string name="ds_copy_report">Copy report</string>
    <string name="ds_req_notifications">Notifications</string>
    <string name="ds_req_notifications_why">Without them no alert can show or sound.</string>
    <string name="ds_req_full_screen">Full-screen alerts</string>
    <string name="ds_req_full_screen_why">Lets an alarm open over the lock screen.</string>
    <string name="ds_req_exact_alarm">Alarms and reminders</string>
    <string name="ds_req_exact_alarm_why">Checks for missing readings on time, even when the phone sleeps.</string>
    <string name="ds_req_battery">No battery restrictions</string>
    <string name="ds_req_battery_why">Keeps Sukrara reading the sensor in the background.</string>
    <string name="ds_req_channel">Alert sound and Do Not Disturb</string>
    <string name="ds_req_channel_why">The alert categories must keep their sound and may break through Do Not Disturb.</string>
    <string name="ds_req_dnd">Alarms in Do Not Disturb</string>
    <string name="ds_req_dnd_why">Lets the alerts that ring like an alarm still show and vibrate in a Do Not Disturb mode that silences alarms, such as a bedtime mode.</string>
    <string name="ds_req_unlocked">Sound while the phone is unlocked</string>
    <string name="ds_req_unlocked_why">Android\'s Notification cooldown › Vibrate only when unlocked mutes every alert sound, alarms too, while you use the phone. Android doesn\'t let apps read it: check it once and tell Sukrara.</string>
    <string name="ds_unlocked_open">Open the setting</string>
    <string name="ds_unlocked_off">It\'s off</string>
    <string name="ds_unlocked_app">Keep it on</string>
    <string name="ds_unlocked_app_note">While the phone is unlocked, Sukrara plays the alert sound itself; Android only vibrates.</string>
    <string name="ds_req_bluetooth">Bluetooth</string>
    <string name="ds_req_bluetooth_why">The sensor sends readings over Bluetooth.</string>

