<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Exported without a permission on purpose: the launcher (any home app) sends the widget broadcasts and
             opens the settings screen; they only redraw / edit this placement and show nothing beyond the widget. -->
        <receiver
            android:name="app.mauri.sukrara.widgets.ValueWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_value_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_value_info" />
        </receiver>
        <receiver
            android:name="app.mauri.sukrara.widgets.GraphWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_graph_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_graph_info" />
        </receiver>
        <receiver
            android:name="app.mauri.sukrara.widgets.CombinedWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_combined_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combined_info" />
        </receiver>
        <!-- The lock-screen widget (#66): bound and hosted only by Sukrara's System UI module (no picker offers it).
             Exported for the system's widget broadcasts, like the others; they only redraw it. -->
        <receiver
            android:name="app.mauri.sukrara.widgets.LockWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_lock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lock_info" />
        </receiver>
        <activity
            android:name="app.mauri.sukrara.widgets.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- the widgets' own redraw alarm at the picture's next freshness step (explicit PendingIntent from this app) -->
        <receiver
            android:name="app.mauri.sukrara.widgets.WidgetRedrawReceiver"
            android:exported="false" />
        <!-- WidgetProbe: measures the size the launcher really gives a widget (it loads one of the probe's images).
             Exported so the launcher can read it, as in the PoC: it answers only a probe in progress (a random
             nonce in the path), returns a 1×1 transparent PNG and nothing else. -->
        <provider
            android:name="app.mauri.sukrara.widgets.ProbeProvider"
            android:authorities="${applicationId}.widgetprobe"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
        <!-- requestPinAppWidget's success callback (explicit PendingIntent from this app) -->
        <receiver
            android:name="app.mauri.sukrara.widgets.WidgetPresence$PinnedReceiver"
            android:exported="false" />
    </application>
</manifest>
