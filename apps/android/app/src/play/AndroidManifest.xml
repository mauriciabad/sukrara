<!--
  The Google Play build's differences from the merged manifest (docs/20-publishing.md › Flavors). The list it must end
  up with is tools/check/allow.json `permissions` changed by `play_permissions` (ManifestTest; verify-apk.sh on the
  bundle's universal APK, from tools/release/play-bundle.sh).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Play allows USE_EXACT_ALARM only for alarm-clock and calendar apps. SCHEDULE_EXACT_ALARM can be refused by
         the person: the alert checklist then names *Alarms and reminders* and opens Android's page, and the checks
         fall back to inexact while-idle alarms (monitor service/AlarmPolicy). -->
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- No System UI module, no root status bar: nothing to feed, nothing to say hello. -->
    <permission
        android:name="${applicationId}.permission.SYSTEMUI_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.permission.SYSTEMUI_STATE"
        tools:node="remove" />

    <application>
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            tools:node="remove" />
        <receiver
            android:name="app.mauri.sukrara.monitor.systemui.HookHelloReceiver"
            tools:node="remove" />
    </application>
</manifest>
