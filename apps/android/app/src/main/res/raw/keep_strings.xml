<!-- Every string stays through resource shrinking: alert and mute texts are looked up by name (MuteText.get,
     AlertNotifier: getIdentifier), which the shrinker can't see; without them a real alert's notification can't be
     built and no alert is posted. verify-apk.sh checks every module string is in the release APK. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:keep="@string/*" />
