<!--
  The app's own components. Each library module declares its own components (services, receivers, providers, widget
  receivers…) and the permissions and <queries> its code uses, each with why, in its manifest; the build merges them
  (docs/ARCHITECTURE.md §Android lists them all). The merged list is pinned in tools/check/allow.json `permissions` /
  `queries` (ManifestTest on every build, verify-apk.sh on the release APK): a change there fails until the list says
  why. ManifestTest checks the merged result's components too.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- androidx.credentials (Backup: the identity to / from the password manager) brings androidx.biometric, which
         declares these for its own in-app prompt. Sukrara never shows one: the system's Credential Manager sheet asks
         for the screen lock itself. -->
    <uses-permission
        android:name="android.permission.USE_BIOMETRIC"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove" />

    <!-- Secrets (identity, sensor pairing) and health data never leave the phone: no backup, no device transfer. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sukrara.Window">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- sukrara:join#…: the invite page's "Open in Sukrara" button where App Links aren't verified -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sukrara" />
            </intent-filter>
            <!-- invites: https://sukrara.mauri.app/join#… (assetlinks.json on the site lists this app) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="sukrara.mauri.app" />
                <data android:pathPrefix="/join" />
            </intent-filter>
        </activity>
        <!-- The new-sensor flow from Sukrara's own notifications, widgets and sensor taps (NavTargets.SENSOR_SETUP_ACTIVITY):
             not exported, so no other app can open the flow; it signs the request for MainActivity (SensorSetupGate). -->
        <activity
            android:name=".SensorSetupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Health Connect grants health permissions only to apps that show their privacy rationale -->
        <activity-alias
            android:name=".HealthPermissionsRationale"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
