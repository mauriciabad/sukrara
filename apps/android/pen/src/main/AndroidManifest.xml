<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the read card's haptics -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- reading the pen with a tap -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <!-- pens through Juggluco: whether it is installed (PensModule) -->
    <queries>
        <package android:name="tk.glucodata" />
    </queries>

    <application>
        <!-- enabled at runtime only while pens are on -->
        <activity
            android:name=".PenTapActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.DISPATCH_NFC_MESSAGE"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_pen" />
        </activity>
        <activity
            android:name=".PenReadActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Sukrara.Window.Overlay" />
        <!-- the pen notifications' buttons (only Sukrara's own PendingIntents) -->
        <receiver
            android:name=".PenActionReceiver"
            android:exported="false" />
    </application>
</manifest>
