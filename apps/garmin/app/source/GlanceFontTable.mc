// Generated by apps/garmin/app/tools/fonts.py (do not edit): the glance's fonts and icons, scoped to the glance.
import Toybox.Lang;
import Toybox.WatchUi;

(:glance)
module GlanceFontTable {
    // key → [atlas bitmap, glyph table (jsonData: [glyphs, metrics in base64, baseline])], or [font resource,
    // baseline px from the line's top]; [] = not here
    function atlas(key as String) as Array {
        var i = ["n54", "n58", "a15s", "a16s", "a17m", "a18m", "a18s", "a20b", "a23b", "a24s", "a24b", "a38s"].indexOf(key);
        if (i < 0) {
            return [];
        }
        if (i < 2) {
            return [[Rez.Drawables.n54, Rez.Drawables.n58][i], [Rez.JsonData.n54_m, Rez.JsonData.n58_m][i]];
        }
        i -= 2;
        return [[Rez.Fonts.a15s, Rez.Fonts.a16s, Rez.Fonts.a17m, Rez.Fonts.a18m, Rez.Fonts.a18s, Rez.Fonts.a20b, Rez.Fonts.a23b, Rez.Fonts.a24s, Rez.Fonts.a24b, Rez.Fonts.a38s][i], [15, 16, 17, 18, 18, 20, 23, 24, 24, 37][i]];
    }

    function sheet() as ResourceId {
        return Rez.Drawables.gicons;
    }

    // the icon sheet's tiles (white with alpha, 2 px margin): [x, y, box], the nearest size up
    function icon(name as String, size as Number) as Array? {
        if (name.equals("rapid")) {
            if (true) { return [0, 0, 16]; }
        } else if (name.equals("long")) {
            if (true) { return [17, 0, 16]; }
        } else if (name.equals("carbs")) {
            if (true) { return [34, 0, 16]; }
        } else if (name.equals("bellPause")) {
            if (true) { return [51, 0, 16]; }
        } else if (name.equals("bellOff")) {
            if (true) { return [68, 0, 16]; }
        } else if (name.equals("note")) {
            if (true) { return [85, 0, 16]; }
        }
        return null;
    }
}
