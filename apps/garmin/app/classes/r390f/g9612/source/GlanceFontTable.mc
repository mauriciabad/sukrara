import Toybox.Lang;
import Toybox.WatchUi;

(:glance)
module GlanceFontTable {
    // the class, r390 (app.js CLS, SPEC §14; the app's own constants are AppFontTable's): the 64-colour palette, the atlas set
    const MIP = false;
    // the glance's scale: its content area (the device file's) over the 390's glance, 248 × 103; its fonts are made at it
    const GS = 0.961165;
    const R390 = true; // the design's class: its approved sizes and strokes are drawn as they are
    const ATLAS = [14, 16, 18, 20, 22, 24, 26, 28, 30, 32, 36, 40, 44, 48, 52, 56, 60, 64, 72, 80, 88, 96, 104, 112, 120, 128, 136, 148];

    // key → [atlas bitmap, glyph table (jsonData: [glyphs, two Numbers a glyph, baseline])], or [font resource,
    // baseline px from the line's top]; [] = not here
    function atlas(key as String) as Array {
        var i = ["a14s", "a16m", "a16s", "a18m", "a18s", "a20b", "a22b", "a24b", "a24s", "a36s", "n40", "n44", "n48", "n52", "n56"].indexOf(key);
        if (i < 0) {
            return [];
        }
        return [[Rez.Fonts.a14s, Rez.Fonts.a16m, Rez.Fonts.a16s, Rez.Fonts.a18m, Rez.Fonts.a18s, Rez.Fonts.a20b, Rez.Fonts.a22b, Rez.Fonts.a24b, Rez.Fonts.a24s, Rez.Fonts.a36s, Rez.Fonts.n40, Rez.Fonts.n44, Rez.Fonts.n48, Rez.Fonts.n52, Rez.Fonts.n56][i], [14, 16, 16, 18, 18, 20, 22, 24, 24, 35, 39, 43, 47, 51, 55][i]];
    }

    // the icon font [i]: one per size
    function sheet(i as Number) as ResourceId {
        return [Rez.Fonts.gicons12][i] as ResourceId;
    }

    // the icons: [glyph index, 0, box, font] of the nearest size (2 px margin)
    function icon(name as String, size as Number) as Array? {
        if (name.equals("rapid")) {
            if (true) { return [0, 0, 16, 0]; }
        } else if (name.equals("long")) {
            if (true) { return [1, 0, 16, 0]; }
        } else if (name.equals("carbs")) {
            if (true) { return [2, 0, 16, 0]; }
        } else if (name.equals("bellPause")) {
            if (true) { return [3, 0, 16, 0]; }
        } else if (name.equals("bellOff")) {
            if (true) { return [4, 0, 16, 0]; }
        } else if (name.equals("note")) {
            if (true) { return [5, 0, 16, 0]; }
        }
        return null;
    }
}
