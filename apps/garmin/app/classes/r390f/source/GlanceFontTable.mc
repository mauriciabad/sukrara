import Toybox.Lang;
import Toybox.WatchUi;

(:glance)
module GlanceFontTable {
    // the class (app.js CLS, SPEC §14): layout units → px, the 64-colour palette, a rectangle, the atlas set
    const CLS = "r390";
    const R390 = true; // the design's class: its approved sizes and strokes are drawn as they are
    const S = 1.0;
    const MIP = false;
    const RECT = false;
    const PLAIN = true; // no tinted bitmaps: texts and icons are font resources
    const ATLAS = [14, 16, 18, 20, 22, 24, 26, 28, 30, 32, 36, 40, 44, 48, 52, 56, 60, 64, 72, 80, 88, 96, 104, 112, 120, 128, 136, 148];
    // the buttons: START, BACK, UP, DOWN (round: degrees clockwise from 12; rectangles: px from the top)
    const KEYS = [60, 120, 270, 240];

    // key → [atlas bitmap, glyph table (jsonData: [glyphs, two Numbers a glyph, baseline])], or [font resource,
    // baseline px from the line's top]; [] = not here
    function atlas(key as String) as Array {
        var i = ["a14s", "a15s", "a16m", "a16s", "a17m", "a18m", "a18s", "a20b", "a22b", "a23b", "a24b", "a24s", "a26b", "a26s", "a36s", "a38s", "a40s", "n40", "n42", "n44", "n46", "n48", "n50", "n52", "n54", "n56", "n58", "n60"].indexOf(key);
        if (i < 0) {
            return [];
        }
        return [[Rez.Fonts.a14s, Rez.Fonts.a15s, Rez.Fonts.a16m, Rez.Fonts.a16s, Rez.Fonts.a17m, Rez.Fonts.a18m, Rez.Fonts.a18s, Rez.Fonts.a20b, Rez.Fonts.a22b, Rez.Fonts.a23b, Rez.Fonts.a24b, Rez.Fonts.a24s, Rez.Fonts.a26b, Rez.Fonts.a26s, Rez.Fonts.a36s, Rez.Fonts.a38s, Rez.Fonts.a40s, Rez.Fonts.n40, Rez.Fonts.n42, Rez.Fonts.n44, Rez.Fonts.n46, Rez.Fonts.n48, Rez.Fonts.n50, Rez.Fonts.n52, Rez.Fonts.n54, Rez.Fonts.n56, Rez.Fonts.n58, Rez.Fonts.n60][i], [14, 15, 16, 16, 17, 18, 18, 20, 22, 23, 24, 24, 26, 26, 35, 37, 39, 39, 41, 43, 45, 47, 49, 51, 53, 55, 57, 59][i]];
    }

    // the icon font [i]: one per size
    function sheet(i as Number) as ResourceId {
        return [Rez.Fonts.gicons12, Rez.Fonts.gicons13][i] as ResourceId;
    }

    // the icons: [glyph index, 0, box, font] of the nearest size (2 px margin)
    function icon(name as String, size as Number) as Array? {
        if (name.equals("rapid")) {
            if (size <= 12) { return [0, 0, 16, 0]; }
            else if (true) { return [0, 0, 17, 1]; }
        } else if (name.equals("long")) {
            if (size <= 12) { return [1, 0, 16, 0]; }
            else if (true) { return [1, 0, 17, 1]; }
        } else if (name.equals("carbs")) {
            if (size <= 12) { return [2, 0, 16, 0]; }
            else if (true) { return [2, 0, 17, 1]; }
        } else if (name.equals("bellPause")) {
            if (size <= 12) { return [3, 0, 16, 0]; }
            else if (true) { return [3, 0, 17, 1]; }
        } else if (name.equals("bellOff")) {
            if (size <= 12) { return [4, 0, 16, 0]; }
            else if (true) { return [4, 0, 17, 1]; }
        } else if (name.equals("note")) {
            if (size <= 12) { return [5, 0, 16, 0]; }
            else if (true) { return [5, 0, 17, 1]; }
        }
        return null;
    }
