# The face under the beta app id (build.sh export-beta): monkey.jungle with the manifest build.sh writes to bin/beta/
# (the app id swapped). Here, not in bin/, so the screen sizes' resource folders (resources-round-<N>x<N>) resolve.
project.manifest = bin/beta/manifest.xml
project.typecheck = 1
base.sourcePath = source
base.resourcePath = resources
base.lang.spa = resources-spa
# the screen sizes' fonts and icons (tools/fonts.py): the default finds them next to the manifest, which is in bin/
round-360x360.resourcePath = $(round-360x360.resourcePath);resources-round-360x360
round-390x390.resourcePath = $(round-390x390.resourcePath);resources-round-390x390
round-416x416.resourcePath = $(round-416x416.resourcePath);resources-round-416x416
round-454x454.resourcePath = $(round-454x454.resourcePath);resources-round-454x454
round-466x466.resourcePath = $(round-466x466.resourcePath);resources-round-466x466
