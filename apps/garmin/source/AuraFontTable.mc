// Generated by apps/garmin/tools/fonts.py (do not edit): the fonts of SPEC.md §2 as atlases and their glyph
// tables (jsonData: [glyphs, metrics in base64, baseline]), and the icons. The same for every screen size: the
// resources (resources-round-<N>x<N>/) and the size's table (Rez.JsonData.sizeTable) hold the pixels.
import Toybox.Lang;
import Toybox.WatchUi;

module AuraFontTable {
    // key → [atlas bitmap, glyph table], or [font resource, its index in the size table's baselines] (the small
    // straight texts: Connect IQ fonts, in the graphics pool; an atlas's glyph table is in the heap while it's loaded)
    function atlas(key as String) as Array {
        var i = ["t62", "t64", "t66", "t68", "t70", "t72", "t74", "t76", "t62o", "t64o", "t66o", "t68o", "t70o", "t72o", "t74o", "t76o", "t62h", "t64h", "t66h", "t68h", "t70h", "t72h", "t74h", "t76h", "v54", "v56", "v58", "v60", "v54h", "v56h", "v58h", "v60h", "g36", "g40", "d26", "d26b", "l24m", "l24s", "l20s", "l20b", "l22s", "l22b", "l25m", "l25s", "l26m", "l30s", "l32s"].indexOf(key);
        if (i < 0) {
            return [];
        }
        if (i < 38) {
            return [[Rez.Drawables.t62, Rez.Drawables.t64, Rez.Drawables.t66, Rez.Drawables.t68, Rez.Drawables.t70, Rez.Drawables.t72, Rez.Drawables.t74, Rez.Drawables.t76, Rez.Drawables.t62o, Rez.Drawables.t64o, Rez.Drawables.t66o, Rez.Drawables.t68o, Rez.Drawables.t70o, Rez.Drawables.t72o, Rez.Drawables.t74o, Rez.Drawables.t76o, Rez.Drawables.t62h, Rez.Drawables.t64h, Rez.Drawables.t66h, Rez.Drawables.t68h, Rez.Drawables.t70h, Rez.Drawables.t72h, Rez.Drawables.t74h, Rez.Drawables.t76h, Rez.Drawables.v54, Rez.Drawables.v56, Rez.Drawables.v58, Rez.Drawables.v60, Rez.Drawables.v54h, Rez.Drawables.v56h, Rez.Drawables.v58h, Rez.Drawables.v60h, Rez.Drawables.g36, Rez.Drawables.g40, Rez.Drawables.d26, Rez.Drawables.d26b, Rez.Drawables.l24m, Rez.Drawables.l24s][i], [Rez.JsonData.t62_m, Rez.JsonData.t64_m, Rez.JsonData.t66_m, Rez.JsonData.t68_m, Rez.JsonData.t70_m, Rez.JsonData.t72_m, Rez.JsonData.t74_m, Rez.JsonData.t76_m, Rez.JsonData.t62o_m, Rez.JsonData.t64o_m, Rez.JsonData.t66o_m, Rez.JsonData.t68o_m, Rez.JsonData.t70o_m, Rez.JsonData.t72o_m, Rez.JsonData.t74o_m, Rez.JsonData.t76o_m, Rez.JsonData.t62h_m, Rez.JsonData.t64h_m, Rez.JsonData.t66h_m, Rez.JsonData.t68h_m, Rez.JsonData.t70h_m, Rez.JsonData.t72h_m, Rez.JsonData.t74h_m, Rez.JsonData.t76h_m, Rez.JsonData.v54_m, Rez.JsonData.v56_m, Rez.JsonData.v58_m, Rez.JsonData.v60_m, Rez.JsonData.v54h_m, Rez.JsonData.v56h_m, Rez.JsonData.v58h_m, Rez.JsonData.v60h_m, Rez.JsonData.g36_m, Rez.JsonData.g40_m, Rez.JsonData.d26_m, Rez.JsonData.d26b_m, Rez.JsonData.l24m_m, Rez.JsonData.l24s_m][i]];
