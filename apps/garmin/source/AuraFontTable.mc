    // an icon's index in the size table's boxes (Rez.JsonData.sizeTable: icons.png, white with alpha, 2 px margin):
    // the icons of SPEC.md §2 at the sizes 20/21/22/24 each, then the pill's bells
    function icon(name as String, size as Number) as Number? {
        var n = ["sun", "steps", "sunset", "bolt", "mountain", "heart", "bell", "ring", "globe", "stairs", "phoneOff", "sensor", "rapid", "long", "carbs", "battery", "bell_paused", "bell_off"].indexOf(name);
        if (n < 0) {
            return null;
        }
        if (n >= 16) {
            return 64 + n - 16;
        }
        return n * 4 + (size <= 20 ? 0 : size <= 21 ? 1 : size <= 22 ? 2 : 3);
    }
}
