import Toybox.Lang;
import Toybox.Test;

// The barrel against contracts/watchface/payload/cases.json (SukraraFaceCases, generated by
// apps/garmin/tools/link_cases.py), the way a face uses it: keep (onBackgroundData) and readingAt (every draw).
// apps/garmin/tools/sdk-test.sh runs them in the simulator.

// every face case: the payload received at a watch time gives what the case expects at each later watch time
(:test)
function sukraraFaceEveryCase(logger as Logger) as Boolean {
    var ok = true;
    var cases = SukraraFaceCases.cases();
    for (var c = 0; c < cases.size(); c++) {
        var k = cases[c] as Dictionary;
        var payload = k.get("payload") as Dictionary;
        var checks = k.get("watch") as Array;
        for (var w = 0; w < checks.size(); w++) {
            var check = checks[w] as Dictionary;
            var received = check.get("received");
            var at = SukraraFaceCases.NOW + (received == null ? 0 : received as Number);
            SukraraFace.forget();
            if (!SukraraFace.keep(payload, at)) {
                logger.error(k.get("name") + ": not kept");
                ok = false;
                continue;
            }
            var r = SukraraFace.readingAt(SukraraFaceCases.NOW + (check.get("at") as Number)) as SukraraFace.Reading;
            var skew = SukraraFace.skewOf(payload.get("sent") as Number, at);
            ok = SukraraFaceExpect.check(k.get("name") + " @" + check.get("at"), check.get("expect") as Dictionary,
                SukraraFaceExpect.inputs(r, skew), logger) && ok;
        }
    }
    SukraraFace.forget();
    return ok;
}

// the newest by sent wins, unless the stored one is far ahead of the watch clock; other versions, other profiles and
// anything that isn't a payload are never kept
(:test)
function sukraraFaceKeepsTheNewest(logger as Logger) as Boolean {
    var ok = true;
    var older = SukraraFaceCases.older();
    for (var i = 0; i < older.size(); i++) {
        var o = older[i] as Dictionary;
        SukraraFace.forget();
        var stored = o.get("stored") as Number;
        SukraraFace.keep({"v" => SukraraFace.VERSION, "p" => "face", "sent" => stored}, stored);
        SukraraFace.keep({"v" => SukraraFace.VERSION, "p" => "face", "sent" => o.get("incoming")}, o.get("watch") as Number);
        var want = "stored".equals(o.get("keep")) ? stored : o.get("incoming");
        var got = (SukraraFace.payload() as Dictionary).get("sent");
        if (got != want) {
            logger.error("order case " + i + ": kept " + got + ", expected " + want);
            ok = false;
        }
    }
    var ignored = SukraraFaceCases.ignored();
    var others = SukraraFaceCases.app().addAll(SukraraFaceCases.field());
    for (var i = 0; i < others.size(); i++) {
        ignored.add((others[i] as Dictionary).get("payload"));
    }
    for (var i = 0; i < ignored.size(); i++) {
        SukraraFace.forget();
        if (SukraraFace.keep(ignored[i], SukraraFaceCases.NOW)) {
            logger.error("kept " + ignored[i]);
            ok = false;
        }
    }
    // what is kept survives a restart (the face's storage)
    var first = (SukraraFaceCases.cases()[0] as Dictionary).get("payload") as Dictionary;
    SukraraFace.forget();
    SukraraFace.keep(first, SukraraFaceCases.NOW);
    SukraraFace._loaded = false;
    SukraraFace._payload = null;
    Test.assertEqualMessage((SukraraFace.payload() as Dictionary).get("sent"), first.get("sent"), "kept in storage");
    SukraraFace.forget();
    Test.assertMessage(SukraraFace.reading() == null, "nothing before Sukrara answers");
    return ok;
}

// the value as the person reads it, its freshness, the trend and its place among the person's limits
(:test)
function sukraraFaceValue(logger as Logger) as Boolean {
    Test.assertEqual(SukraraFace.text(39, "mgdl"), "LO");
    Test.assertEqual(SukraraFace.text(401, "mmol"), "HI");
    Test.assertEqual(SukraraFace.text(112, "mgdl"), "112");
    Test.assertEqual(SukraraFace.text(112, "mmol"), "6.2");
    Test.assertEqual(SukraraFace.freshness(90), SukraraFace.CURRENT);
    Test.assertEqual(SukraraFace.freshness(91), SukraraFace.LATE);
    Test.assertEqual(SukraraFace.freshness(300), SukraraFace.LATE);
    Test.assertEqual(SukraraFace.freshness(301), SukraraFace.STRUCK);
    Test.assertEqual(SukraraFace.freshness(1200), SukraraFace.STRUCK);
    Test.assertEqual(SukraraFace.freshness(1201), SukraraFace.GONE);
    var now = SukraraFaceCases.NOW;
    var p = {"v" => 5, "p" => "face", "sent" => now, "unit" => "mgdl", "bands" => [55, 70, 140, 180, 250, 300],
        "g" => {"t" => now, "v" => 180, "rate" => 1.0, "band" => 1, "deg" => -30.0}, "hist" => [], "st" => null,
        "last" => null, "sensor" => {"s" => "active"}, "tir" => null};
    var levels = [[55, -2], [56, -1], [69, -1], [70, 0], [179, 0], [180, 1], [250, 2], [300, 3]];
    for (var i = 0; i < levels.size(); i++) {
        (p.get("g") as Dictionary).put("v", levels[i][0]);
        Test.assertEqualMessage(new SukraraFace.Reading(p, 0, now).level(), levels[i][1], "level of " + levels[i][0]);
    }
    (p.get("g") as Dictionary).put("v", 180);
    var r = new SukraraFace.Reading(p, 0, now + 300);
    Test.assertMessage(r.trend() && "180".equals(r.text()), "late: the value and its trend");
    r = new SukraraFace.Reading(p, 0, now + 301);
    Test.assertMessage(!r.trend() && "180".equals(r.text()), "struck: the value without its trend");
    r = new SukraraFace.Reading(p, 0, now + 1201);
    Test.assertMessage(r.text() == null, "gone: no value");
    // a phone clock 60 s ahead: the reading is 60 s old on the watch's clock already
    r = new SukraraFace.Reading(p, 60, now);
    Test.assertEqualMessage(r.ageS, 60, "the skew");
    return true;
}
