# The debug case loader (build.sh aura cases): the face plus source-cases/ and the generated cases (tools/cases.py). Never a
# release build: build.sh builds it without -r, and the release jungle (monkey.jungle) has none of these paths.
project.manifest = manifest-cases.xml
base.sourcePath = source;../shared/link;../sdk/source/read;source-cases;build/cases/source
base.resourcePath = resources;build/cases/resources
project.typecheck = 1
base.lang.spa = resources-spa
base.excludeAnnotations = app;field;complications
# BEGIN launcher icon sizes (apps/garmin/tools/launcher_icons.py)
# each watch's launcher icon at its launcherIcon size (MIP: the 64-colour one)
approachs7042mm.resourcePath = $(approachs7042mm.resourcePath);resources-launcher60
descentmk343mm.resourcePath = $(descentmk343mm.resourcePath);resources-launcher60
epix2pro42mm.resourcePath = $(epix2pro42mm.resourcePath);resources-launcher60
fr57042mm.resourcePath = $(fr57042mm.resourcePath);resources-launcher54
marq2.resourcePath = $(marq2.resourcePath);resources-launcher60
marq2aviator.resourcePath = $(marq2aviator.resourcePath);resources-launcher60
venu3s.resourcePath = $(venu3s.resourcePath);resources-launcher70
venu441mm.resourcePath = $(venu441mm.resourcePath);resources-launcher54
vivoactive6.resourcePath = $(vivoactive6.resourcePath);resources-launcher54
# END launcher icon sizes
