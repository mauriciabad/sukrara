# The sample watch face that reads Sukrara (sukrara.mauri.app/developers/garmin-faces/, docs/GARMIN-FACES.md):
# apps/garmin/build.sh sample. CI builds it, so the example there can't rot.
project.manifest = manifest.xml
project.typecheck = 1
base.sourcePath = source
base.resourcePath = resources
# the SukraraFace barrel, as its project here; your face names the downloaded file: base.barrelPath = barrels/SukraraFace.barrel
base.barrelPath = ../sdk/monkey.jungle
