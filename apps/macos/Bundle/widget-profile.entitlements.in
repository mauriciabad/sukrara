<!-- The widget signed with its provisioning profile (bundle.sh embeds it as Contents/embedded.provisionprofile):
     what widget.entitlements.in has (sandboxed, the App Group snapshot only, no network) plus its App ID. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key><string>@TEAM@.app.mauri.sukrara.widget</string>
	<key>com.apple.developer.team-identifier</key><string>@TEAM@</string>
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.application-groups</key><array><string>@GROUP@</string></array>
</dict>
</plist>
