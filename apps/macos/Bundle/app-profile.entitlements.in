<!-- The app signed with a provisioning profile (bundle.sh embeds it as Contents/embedded.provisionprofile): what
     app.entitlements.in has (not sandboxed, hardened runtime only, the App Group shared with the widget), plus what
     only a profile grants. Time Sensitive: alarms break through a Focus (TimeSensitive). keychain-access-groups: the
     follower key in the data-protection keychain (KeychainStore.secrets). Associated Domains: the web invite
     https://sukrara.mauri.app/join opens the app (docs/.well-known/apple-app-site-association). The app reads them
     at launch (Entitlements.current) and falls back without them. No get-task-allow. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key><string>@TEAM@.app.mauri.sukrara</string>
	<key>com.apple.developer.team-identifier</key><string>@TEAM@</string>
	<key>com.apple.security.application-groups</key><array><string>@GROUP@</string></array>
	<key>com.apple.developer.usernotifications.time-sensitive</key><true/>
	<key>keychain-access-groups</key><array><string>@TEAM@.app.mauri.sukrara</string></array>
	<key>com.apple.developer.associated-domains</key><array><string>applinks:sukrara.mauri.app</string></array>
</dict>
</plist>
