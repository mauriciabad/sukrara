<!-- The app: not sandboxed (hardened runtime only), shares the App Group with the widget. No get-task-allow. The
     camera (the follow step's QR scanner): the hardened runtime blocks it without device.camera. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key><array><string>@GROUP@</string></array>
	<key>com.apple.security.device.camera</key><true/>
</dict>
</plist>
