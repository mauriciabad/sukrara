{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ alert at night" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ alert at night"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerta de %@ de noche"
          }
        }
      }
    },
    "%@ didn't allow you. Ask them for a new link and paste it here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ didn't allow you. Ask them for a new link and paste it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no te ha dado acceso. Pídele un enlace nuevo y pégalo aquí."
          }
        }
      }
    },
    "%@ invited you to see their glucose. Follow asks %@ to allow this Mac; nothing is shared until they do." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ invited you to see their glucose. Follow asks %@ to allow this Mac; nothing is shared until they do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ te ha invitado a ver su glucosa. Seguir pide a %2$@ que dé acceso a este Mac; no se comparte nada hasta que lo haga."
          }
        }
      }
    },
    "%@ on widgets" : {
      "comment" : "Under a Graph setting: the widgets' own value where it differs from the menu bar's (\"6 h on widgets\", \"Off on widgets\")",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on widgets"
          }
        },
        "es" : {
