    "%@'s phone is told." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'s phone is told."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se avisa al móvil de %@."
          }
        }
      }
    },
    "%@'s Sukrara already sends this Mac the glucose it reads, from whichever source it uses, with treatments, pen doses, alerts and settings. Reading %@ here instead means this Mac stops following it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'s Sukrara already sends this Mac the glucose it reads, from whichever source it uses, with treatments, pen doses, alerts and settings. Reading %@ here instead means this Mac stops following it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Sukrara de %1$@ ya envía a este Mac la glucosa que lee, de la fuente que use, con tratamientos, dosis de bolígrafo, alertas y ajustes. Leer %2$@ aquí en su lugar hace que este Mac deje de seguirlo."
          }
        }
      }
    },
