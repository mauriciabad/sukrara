    "Shows to the left of the main metric, when there's room. A small widget shows fewer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows to the left of the main metric, when there's room. A small widget shows fewer."
