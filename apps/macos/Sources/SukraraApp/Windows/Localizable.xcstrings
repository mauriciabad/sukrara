    "Alert me, also when muted here, if nobody answers it on their phone: “Very low · no response”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alert me, also when muted here, if nobody answers it on their phone: “Very low · no response”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisarme, también si he silenciado aquí, si nadie la responde en su teléfono: «Muy baja · sin respuesta»."
          }
        }
      }
    },
