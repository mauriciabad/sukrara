<!-- The fgsOnly flavor: only the foreground-service exemption, no run / data in the background. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission
        android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REQUEST_COMPANION_USE_DATA_IN_BACKGROUND"
        tools:node="remove" />
</manifest>
